{
  "name": "hifun-mcp",
  "version": "0.1.1",
  "description": "嗨番 MCP 共享工具集合；当前提供图像诊断，后续按版本增加通用能力。",
  "homepage": "https://github.com/woshiyjy/HiFun_MCP_Plugins",
  "author": "HiFun",
  "skills": "./skills/",
  "interface": {
    "displayName": "嗨番 MCP",
    "shortDescription": "嗨番共享工具集合，当前支持图像诊断",
    "developerName": "HiFun"
  },
  "mcpServers": {
